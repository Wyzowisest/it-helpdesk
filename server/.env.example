# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/it_helpdesk_system?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set this to a strong unique password before running the production seed script.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
